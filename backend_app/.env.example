PORT=3000

# Actual Budget server (self-hosted)
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=
ACTUAL_DATA_DIR=./actual-cache
ACTUAL_BUDGET_SYNC_ID=

# Switch #1: which parsing strategy is active (see src/index.ts).
#   regex (default) - only ActivoBank/moey!/Trade Republic regex parsers.
#                      Fully offline, nothing is ever sent anywhere.
#   ai               - every statement's PDF bytes go straight to the AI
#                       provider below, no local text extraction at all.
#   both             - regex parsers first, AI parser as a text-based
#                       fallback for statements none of them recognized.
PARSER_MODE=regex

# Switch #2: which AI vendor backs the AI parser, only read when
# PARSER_MODE is "ai" or "both" (see src/parsers/ai-providers/index.ts).
#   anthropic (default) - requires ANTHROPIC_API_KEY
#   gemini              - requires GEMINI_API_KEY
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local category memory (see src/categorydb.ts) — a SQLite file mapping
# payee -> category so imports can be pre-categorized. Safe to leave
# unset; the file/folder is created automatically on first use.
CATEGORY_DB_PATH=./data/categories.db
