PORT=3000

# Shared-secret auth: the mobile app must send this in an X-Import-Token
# header on every request except GET /health. Leave unset to run with no
# authentication at all (fine for a quick local test, not recommended
# otherwise — anything on the LAN can read/write your budget while unset).
IMPORT_TOKEN=

# Actual Budget server (self-hosted). OPTIONAL: leave ACTUAL_SERVER_URL empty
# and connect from the app instead (Settings -> Connection); the backend runs
# and parses statements without one. Setting it here LOCKS the connection:
# the app shows it but can't change it. The app needs IMPORT_TOKEN set to
# change the connection.
ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=
ACTUAL_DATA_DIR=./actual-cache
# Reads reuse the downloaded budget for this long (ms) before syncing with
# the server again; writes always sync. 0 = sync before every request.
SYNC_INTERVAL_MS=5000
# Default budget's sync id (Actual -> Settings -> Show advanced settings).
# GET /budgets lists every budget on the server; most requests can pass
# their own "budgetSyncId" to use a different one, falling back to this
# default when they don't.
ACTUAL_BUDGET_SYNC_ID=

# Statements are read on the phone. The backend reads only the ones the
# phone can't (an unknown bank), and only with an AI provider: set
# AI_PROVIDER and its API key below. Without a key, POST /parse answers
# AI_NOT_CONFIGURED and everything else works (see src/index.ts).
# (PARSER_MODE is gone: the regex parsers moved to the app.)

# Which AI vendor reads statements (see src/parsers/ai-providers/index.ts).
#   anthropic (default) - requires ANTHROPIC_API_KEY
#   gemini              - requires GEMINI_API_KEY
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local category memory (see src/categorydb.ts) — a SQLite file mapping
# payee -> category so imports can be pre-categorized. Safe to leave
# unset; the file/folder is created automatically on first use.
CATEGORY_DB_PATH=./data/categories.db

# Logging (see src/logger.ts). Info, warnings and errors are always written,
# to stdout and to rotated files in LOG_DIR (daily or at 10 MB, 14 kept).
# LOG_DEBUG=true adds the detail: parser steps, budget-session turns, category
# lookups — including payee names. Amounts, tokens and passwords are never
# logged at any level.
LOG_DEBUG=false
# Defaults to a "logs" folder next to CATEGORY_DB_PATH.
LOG_DIR=
