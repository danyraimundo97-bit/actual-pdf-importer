PORT=3000

# Actual Budget server (self-hosted)
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=
ACTUAL_DATA_DIR=./actual-cache
ACTUAL_BUDGET_SYNC_ID=

# The switch: which parsing strategy is active (see src/index.ts).
#   regex (default) - only ActivoBank/moey!/Trade Republic regex parsers.
#                      Fully offline, nothing is ever sent anywhere.
#   ai               - always use the AI parser, for every statement.
#                      Requires ANTHROPIC_API_KEY below.
#   both             - regex parsers first, AI parser as fallback for
#                      statements none of them recognized. Requires
#                      ANTHROPIC_API_KEY below.
PARSER_MODE=regex

# Only read when PARSER_MODE is "ai" or "both".
ANTHROPIC_API_KEY=
AI_PARSER_MODEL=claude-3-5-haiku-latest
